# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (the FE dev server).
CORS_ORIGINS=http://localhost:3000

# --- Logging (pino) ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs. Defaults to true outside production.
LOG_PRETTY=true

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AI Interview Coach
# OPENROUTER_APP_URL=http://localhost:3000

# --- Models per task (optional) ---
# Each is "primary,fallback1,fallback2" (1 to 3 OpenRouter slugs). The first is
# called; OpenRouter switches to the others on outages, rate limits or provider
# errors, and the app retries once on the next model if the output is invalid.
# Unset = the defaults below (from src/llm/llm-tasks.ts). Every model must
# support structured outputs (and tools, for the coach chat).
# LLM_QUESTION_GENERATE_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-6.1-terra,google/gemini-4-argon
# The validator blind-solves each question; keep it a different model family
# from the generator so they don't share blind spots.
# LLM_QUESTION_VALIDATE_MODELS=openai/gpt-6.1-terra,google/gemini-3.8-flash,deepseek/deepseek-v4.1-flash
# LLM_ANSWER_EVALUATE_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna,google/gemini-3.8-flash
# LLM_COACH_CHAT_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna,google/gemini-3.8-flash
# LLM_REPORT_GENERATE_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-6.1-terra,google/gemini-4-argon

# --- Quiz tokens ---
# Seals question/result tokens (AES-256-GCM) so answer keys and scores can't be
# read or edited by the client. At least 32 characters. Generate one with:
#   openssl rand -base64 48
QUIZ_TOKEN_SECRET=
